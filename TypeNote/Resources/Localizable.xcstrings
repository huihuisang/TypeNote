    "1-7=note  0=rest  '=octave up  ,=octave down  _=half duration  -=extend  #/b=sharp/flat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=Note  0=Pause  '=Oktave hoch  ,=Oktave tief  _=halbe Dauer  -=verlängern  #/b=Kreuz/b"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=note  0=rest  '=octave up  ,=octave down  _=half duration  -=extend  #/b=sharp/flat"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=note  0=silence  '=octave haut  ,=octave bas  _=durée moitié  -=prolonger  #/b=dièse/bémol"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=nota  0=pausa  '=ottava su  ,=ottava giù  _=durata metà  -=estendi  #/b=diesis/bemolle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=音符  0=休符  '=オクターブ上  ,=オクターブ下  _=音価半分  -=延長  #/b=半音"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=음표  0=쉼표  '=옥타브 위  ,=옥타브 아래  _=음가 절반  -=연장  #/b=반음"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1-7=音符  0=休止  '=升八度  ,=降八度  _=时值减半  -=延长  #/b=升降号"
          }
        }
      }
    },
